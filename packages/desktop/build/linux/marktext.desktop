[Desktop Entry]
Name=Deskmark
Comment=Local markdown editor with sticky notes, todos, and a calendar
Exec=deskmark %F
Terminal=false
Type=Application
Icon=deskmark
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=deskmark;
StartupWMClass=deskmark
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=deskmark --new-window %F
Icon=deskmark
